<header class="px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between border-b border-zinc-100 py-3 text-sm">
    <div class="flex items-center gap-4">
      <a href="/">
        <img src={~p"/images/raffley-logo.svg"} width="156" />
      </a>
    </div>
    <ul class="flex items-center gap-4 text-sm font-semibold leading-6 text-zinc-900">
      <li>
        <.link navigate={~p"/raffles"} class="hover:text-zinc-700">
          Raffles
        </.link>
      </li>
      <li>
        <.link navigate={~p"/rules"} class="hover:text-zinc-700">
          Rules
        </.link>
      </li>
      <li>
        <.link navigate={~p"/admin/raffles"} class="hover:text-zinc-700">
          Admin
        </.link>
      </li>
      <li>
        <.link navigate={~p"/charities"} class="hover:text-zinc-700">
          Charities
        </.link>
      </li>
      <.link navigate={~p"/dashboard"}>
        Dashboard
      </.link>
    </ul>
  </div>
</header>
<main class="px-4 py-12 sm:px-6 lg:px-8">
  <div class="mx-auto w-full">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
